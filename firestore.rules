rules_version = '2';

// Security rules for the Geezword community signup form.
//
// To deploy:
//   - Firebase Console → Firestore Database → Rules tab → paste this file → Publish
//   - Or via Firebase CLI:  firebase deploy --only firestore:rules
//
// The community-signups collection is write-only from clients (public can create,
// nobody can read/update/delete). Admin reads happen via the Firebase Console.
// Schema and size limits below cap the cost of abuse — an attacker can post
// junk rows, but each row is small and there's no read amplification.

service cloud.firestore {
  match /databases/{database}/documents {

    match /community-signups/{docId} {
      allow create: if
        // Field allow-list — no surprise fields.
        // formVersion 2 (added 2026-08) introduced preferredEmailLanguage +
        // formVersion. Both are OPTIONAL in the allow-list so that any older
        // client/form (v1, which omits them) can still submit successfully;
        // when preferredEmailLanguage IS present it must be one of ti/am/en.
        // utmSource/utmMedium/utmCampaign (added 2026-09) and utmContent
        // (added 2026-10, e.g. the individual campaign video) are optional
        // campaign tags carried to /start by journey.js.
        request.resource.data.keys().hasOnly(
          ['firstName', 'email', 'preferredEmailLanguage', 'interests',
           'source', 'formVersion', 'createdAt',
           'utmSource', 'utmMedium', 'utmCampaign', 'utmContent']
        )

        // firstName: required string, 1–80 chars
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80

        // email: required string, plausibly an email address, 5–200 chars
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')

        // preferredEmailLanguage: OPTIONAL for back-compat with v1 clients;
        // when present must be exactly one of the supported codes.
        && (
          !('preferredEmailLanguage' in request.resource.data)
          || (
            request.resource.data.preferredEmailLanguage is string
            && request.resource.data.preferredEmailLanguage in ['ti', 'am', 'en']
          )
        )

        // interests: required list of 1–8 entries, each one of the 8 slugs the
        // Cloud Functions map to Resend topics (INTEREST_LABELS / TOPIC_IDS in
        // functions/index.js). Keep the two lists in sync.
        && request.resource.data.interests is list
        && request.resource.data.interests.size() >= 1
        && request.resource.data.interests.size() <= 8
        && request.resource.data.interests.hasOnly(
             ['tigrinya', 'amharic', 'geez-kidase', 'childrens-learning',
              'books-courses', 'games', 'keyboards-typing', 'general'])

        // source: string identifying the entry point (e.g. "start-page")
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 50

        // formVersion: OPTIONAL for back-compat; when present must be an int
        && (
          !('formVersion' in request.resource.data)
          || request.resource.data.formVersion is int
        )

        // Campaign tags: each OPTIONAL; when present, 1–50 characters of
        // lowercase a–z, 0–9, ".", "_" or "-", starting with a letter or digit
        // (the /start page normalises to this shape before sending).
        && (!('utmSource' in request.resource.data)
            || (request.resource.data.utmSource is string
                && request.resource.data.utmSource.matches('^[a-z0-9][a-z0-9._-]{0,49}$')))
        && (!('utmMedium' in request.resource.data)
            || (request.resource.data.utmMedium is string
                && request.resource.data.utmMedium.matches('^[a-z0-9][a-z0-9._-]{0,49}$')))
        && (!('utmCampaign' in request.resource.data)
            || (request.resource.data.utmCampaign is string
                && request.resource.data.utmCampaign.matches('^[a-z0-9][a-z0-9._-]{0,49}$')))
        && (!('utmContent' in request.resource.data)
            || (request.resource.data.utmContent is string
                && request.resource.data.utmContent.matches('^[a-z0-9][a-z0-9._-]{0,49}$')))

        // createdAt MUST be a server timestamp (prevents client clock spoofing)
        && request.resource.data.createdAt == request.time;

      // No public read/update/delete. Read submissions in the Firebase Console
      // or via an authenticated admin client (not yet configured).
      allow read, update, delete: if false;
    }

    // Canonical member table (one row per normalized email), maintained
    // exclusively by the syncMemberOnSignup Cloud Function via the Admin SDK
    // (which bypasses these rules). No client access — it holds the email
    // list and unsubscribe status, which must never be publicly readable or
    // writable. Explicit here for documentation; the catch-all would deny too.
    match /members/{memberId} {
      allow read, write: if false;
    }

    // Webhook idempotency ledger (svix-id → handled). Written only by the
    // resendWebhook Cloud Function via the Admin SDK. No client access.
    match /processed_webhooks/{svixId} {
      allow read, write: if false;
    }

    // Server-only configuration (e.g. config/email — feature flags, kill
    // switch, test-mode allowlist). Read/written exclusively by Cloud
    // Functions via the Admin SDK (which bypasses these rules). No client
    // access: never publicly readable or writable.
    match /config/{document} {
      allow read, write: if false;
    }

    // Default deny for any other collection. Tighten/relax later as needed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
